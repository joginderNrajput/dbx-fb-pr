# Copy to .env (git-ignored) and fill in. Never commit real values.
# Databricks workspace (standard Databricks variables, also read by the Databricks CLI)
DATABRICKS_HOST=https://adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_TOKEN=
# or a service principal (OAuth machine-to-machine)
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=

# Tool settings (DBXF_ prefix); see dbx_premig/config.py for every knob
# DBXF_CATALOGS=["main","sales"]
# DBXF_MAX_NOTEBOOKS=5000
# DBXF_INCLUDE_COLUMNS=true
# DBXF_LOG_LEVEL=WARNING

# Assessment rules (formulas for complexity / automation / effort); default = bundled file
# DBXF_ASSESSMENT_RULES=./my_assessment_rules.yaml

# Postgres sink (discovery + assessment tables): the existing Azure Database for PostgreSQL.
# Create the tables once with `python discovery.py db-init` (= alembic upgrade head); the
# Docker image does it on start-up (DBXF_DB_AUTO_MIGRATE=true in docker-compose.yml).
# SSL is required automatically for non-local hosts (override: DBXF_DB_SSLMODE).
DBXF_DATABASE_URL=postgresql+psycopg://<user>:<password>@<server>.postgres.database.azure.com:5432/<database>
# The schema the tables live in. Created by the migration if missing (the role then needs
# CREATE on the database).
DBXF_DB_SCHEMA=databricks_to_fabric_premigration
# Only when the schema already holds another accelerator's totals / inventory / estimation /
# computation tables: prefix ours (dbx_totals, dbx_inventory, ...). db-init refuses to touch
# tables it did not create and tells you to set this.
# DBXF_DB_TABLE_PREFIX=dbx_
# DBXF_DB_AUTO_MIGRATE=false

# REST API
# DBXF_API_PORT=7073
# DBXF_API_KEY=change-me
# DBXF_API_RUN_TTL_S=86400
